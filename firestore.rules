rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated user journal entries: strictly accessible only by the owning authenticated user
    match /users/{uid}/journalEntries/{entryId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null 
                    && request.auth.uid == uid
                    && request.resource.data.title is string
                    && request.resource.data.messages is list;
      allow update: if request.auth != null 
                    && request.auth.uid == uid;
      allow delete: if request.auth != null 
                    && request.auth.uid == uid;
    }

    // User profile document isolated per user
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny all other unmatched paths explicitly
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
